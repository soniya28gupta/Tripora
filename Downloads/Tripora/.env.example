# ===================================================================
# Tripora — Nova AI Assistant Configuration
# ===================================================================
# Nova AI works out-of-the-box in Smart Demo Engine mode without an API key!
# To connect Nova AI to a live Large Language Model (Gemini or OpenAI),
# copy this file to .env and insert your API key below.

# 1. AI API Key (e.g. from Google AI Studio: https://aistudio.google.com/)
AI_API_KEY=your_api_key_here

# 2. Model Identifier (Defaults to 'gemini-1.5-flash' or 'gpt-4o-mini')
AI_MODEL=gemini-1.5-flash

# 3. Optional: Custom Provider API Base URL (leave empty for official endpoints)
# AI_API_BASE_URL=https://generativelanguage.googleapis.com

# 4. Local Server Port (Default: 3000)
PORT=3000

